{
  "version": 4,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "默认配置（Release + fp64 + MPI + OpenMP）",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CS_PRECISION": "fp64",
        "CS_ENABLE_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "调试配置（Debug + 测试全开）",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CS_ENABLE_TESTS": "ON"
      }
    },
    {
      "name": "mixed",
      "displayName": "混合精度（fp32 主体 + fp64 几何/归约）",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-mixed",
      "cacheVariables": {
        "CS_PRECISION": "mixed"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "mixed", "configurePreset": "mixed" }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true }
    }
  ]
}
